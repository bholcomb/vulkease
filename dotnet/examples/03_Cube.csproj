<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>03_Cube</AssemblyName>
    <RootNamespace>VulkEaseExamples</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Package References -->
  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.8.2" />
    <PackageReference Include="VulkEase" Version="2.0.0" />
  </ItemGroup>

  <!-- Source Files -->
  <ItemGroup>
    <Compile Include="03_Cube.cs" />
  </ItemGroup>

  <!-- Copy assets to output -->
  <ItemGroup>
    <Content Include="examples\shaders\**\*.spv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="examples\data\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\VulkEase.csproj" />
  </ItemGroup>

</Project>